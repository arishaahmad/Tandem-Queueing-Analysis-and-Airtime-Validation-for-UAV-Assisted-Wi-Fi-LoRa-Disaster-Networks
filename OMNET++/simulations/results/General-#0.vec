config image-path ../../inet4.4/images
config network uavwifilora.UnifiedDisasterNet20
config sim-time-limit 100s
config simtime-resolution ps
config *.device[*].wlan[0].opMode "\"n(mixed-2.4Ghz)\""
config *.uavWifi.wlan[0].opMode "\"n(mixed-2.4Ghz)\""
config *.device[*].wlan[0].bitrate 6.5Mbps
config *.uavWifi.wlan[0].bitrate 6.5Mbps
config *.device[*].wlan[0].radio.radioMediumModule "\"radioMedium\""
config *.uavWifi.wlan[0].radio.radioMediumModule "\"radioMedium\""
config *.device[*].numApps 1
config *.device[*].app[0].typename UdpBasicApp
config *.device[*].app[0].destAddresses "\"uavWifi\""
config *.device[*].app[0].destPort 5000
config *.device[*].app[0].messageLength 11B
config *.device[*].app[0].startTime "uniform(6s, 8s)"
config *.device[*].app[0].stopTime 8.1s
config *.device[*].app[0].sendInterval 100s
config *.uavWifi.numApps 1
config *.uavWifi.app[0].typename UdpSink
config *.uavWifi.app[0].localPort 5000
config *.uavLoRa.numApps 1
config *.uavLoRa.app[0].typename SimpleLoRaApp
config *.uavLoRa.app[0].relayMode true
config *.uavLoRa.app[0].numberOfPacketsToSend 0
config *.uavLoRa.app[0].timeToFirstPacket 6s
config *.uavLoRa.app[0].dataSize 11B
config *.uavLoRa.app[0].initialLoRaSF 7
config *.uavLoRa.app[0].initialLoRaBW 125kHz
config *.uavLoRa.app[0].initialLoRaCR 1
config *.uavLoRa.app[0].initialLoRaCF 868MHz
config *.uavLoRa.app[0].initialLoRaTP 14dBm
config *.uavLoRa.app[0].evaluateADRinNode false
config *.uavLoRa.LoRaNic.radio.radioMediumModule "\"LoRaMedium\""
config *.baseStation.LoRaGWNic.radio.radioMediumModule "\"LoRaMedium\""
config *.baseStation.numUdpApps 1
config *.baseStation.packetForwarder.localPort 2000
config *.baseStation.packetForwarder.destPort 1000
config *.baseStation.packetForwarder.destAddresses "\"networkServer\""
config *.baseStation.packetForwarder.indexNumber 0
config **.LoRaGWNic.radio.iAmGateway true
config *.networkServer.numApps 1
config *.networkServer.app[0].typename NetworkServerApp
config *.networkServer.app[0].localPort 1000
config *.networkServer.app[0].destPort 2000
config *.networkServer.app[0].destAddresses "\"baseStation\""
config *.networkServer.app[0].evaluateADRinServer false
config **.mobility.initFromDisplayString false
config *.device[*].mobility.initialX "uniform(70m, 130m)"
config *.device[*].mobility.initialY "uniform(70m, 130m)"
config *.device[*].mobility.initialZ 0m
config *.uavWifi.mobility.initialX 150m
config *.uavWifi.mobility.initialY 100m
config *.uavWifi.mobility.initialZ 50m
config *.uavLoRa.mobility.initialX 150m
config *.uavLoRa.mobility.initialY 100m
config *.uavLoRa.mobility.initialZ 50m
config *.baseStation.mobility.initialX 175m
config *.baseStation.mobility.initialY 100m
config *.baseStation.mobility.initialZ 0m
config **.constraintAreaMinX 0m
config **.constraintAreaMinY 0m
config **.constraintAreaMinZ 0m
config **.constraintAreaMaxX 500m
config **.constraintAreaMaxY 500m
config **.constraintAreaMaxZ 100m
config **.maxTransmissionDuration 4s
config **.minInterferenceTime 0s
